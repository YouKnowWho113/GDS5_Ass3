--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e99d2aa6db43f2478d3198a0ca05313, type: 3}
  m_Name: BunCha_after_table_click
  m_EditorClassIdentifier: 
  dialogueInfo:
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CGreetings! Welcome to our restaurant. What would you like to
      order?\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CWell, I heard that\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 0ecc4b1221fa5754691833c65db6aa81, type: 2}
    charText: "\u201CHey! When are you gonna pay this month\u2019s rent, huh?!\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CI\u2019m sorry. I\u2019m really close to having enough. Just
      a few more days, please!\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 0ecc4b1221fa5754691833c65db6aa81, type: 2}
    charText: "\u201CFine. Three days. If not, pack your diner and get out.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CSorry for letting you see that. I hope it doesn\u2019t affect
      your mood.\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CIf you still want to eat here, I\u2019ll only take half the
      price.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CNo, charge the full price. I\u2019m a food critic, so I want
      the normal experience.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CFo-Food critic?! I didn\u2019t have time to prepare anything
      special.\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CIt\u2019s alright. I came here specifically for your B\xFAn
      Ch\u1EA3.\u201D"
    characterEmotion: 0
    continueCheck: 1
