%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e99d2aa6db43f2478d3198a0ca05313, type: 3}
  m_Name: ComChay_after_table_click
  m_EditorClassIdentifier: 
  dialogueInfo:
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\"\u2026Why can\u2019t I stop thinking about what Fendory said?\""
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\"Tch. These notifications won\u2019t stop either.\""
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: '"You look exhausted, dear."'
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\"\u2026Just give me anything warm.\""
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: '"No problem. Sit down first. Rain like this makes people think too
      much."'
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\"I\u2019m not here to think. Just food.\""
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: '"Then warm food it is."'
    characterEmotion: 0
    continueCheck: 1
