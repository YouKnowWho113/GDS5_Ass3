  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e99d2aa6db43f2478d3198a0ca05313, type: 3}
  m_Name: ComChay_after_wrong_submit
  m_EditorClassIdentifier: 
  dialogueInfo:
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: "\"Dear, that sounds like you\u2019re forcing an answer.\""
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: "\"Food this simple doesn\u2019t need to be bullied into sounding important.\""
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\"\u2026Maybe I\u2019m overthinking it.\""
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: '"Look again. Listen again."'
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 0b984171a6a6db64e97413486511e156, type: 2}
    charText: '"The crust, the grains, and the seasoning are already telling you
      enough."'
    characterEmotion: 0
    continueCheck: 1
