MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e99d2aa6db43f2478d3198a0ca05313, type: 3}
  m_Name: Trau_after_table_click
  m_EditorClassIdentifier: 
  dialogueInfo:
  - character: {fileID: 11400000, guid: 1f393af1b4bba2448b35dc18cc95801c, type: 2}
    charText: "\u201CWelcome, sir! Please, have a seat!\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201COh. You\u2019re new? I didn\u2019t see you here last time.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 1f393af1b4bba2448b35dc18cc95801c, type: 2}
    charText: "\u201CYes\u2026 Miss Dina hired me after the restaurant got more customers.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 1f393af1b4bba2448b35dc18cc95801c, type: 2}
    charText: "\u201CShe said it was thanks to a food critic\u2019s review.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201COh! You\u2019re here. Thank you again. You really helped this
      place.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CGuess I\u2019m your prestige guest now, huh?\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 1a5b9bec349684c4fa27f47e4f1c1f8f, type: 2}
    charText: "\u201CYes, you sure are. Please treat him well, okay?\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CSo\u2026 do you have private seating yet?\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 1f393af1b4bba2448b35dc18cc95801c, type: 2}
    charText: "\u201CAh\u2026 I\u2019m sorry, sir, this diner is still quite small\u2026\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CRelax. I\u2019ll take the Tr\xE2u G\xE1c B\u1EBFp. And make
      it quick, please.\u201D"
    characterEmotion: 0
    continueCheck: 0
