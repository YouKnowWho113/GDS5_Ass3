%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e99d2aa6db43f2478d3198a0ca05313, type: 3}
  m_Name: Pho_after_table_click
  m_EditorClassIdentifier: 
  dialogueInfo:
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CEver since I started posting my reviews online\u2026\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CMore and more people have begun recognizing my name.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 26b8df2c53d25774a98417f35663a454, type: 2}
    charText: "\u201CWelcome, sir. Table for one?\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CYes.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 26b8df2c53d25774a98417f35663a454, type: 2}
    charText: "\u201CPlease follow me.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 26b8df2c53d25774a98417f35663a454, type: 2}
    charText: "\u201CIsn\u2019t that the food critic everyone\u2019s talking about
      online lately?\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 6cbc2fe164d1be146948a6741ae3067e, type: 2}
    charText: "\u201COh no\u2026 We need to inform the chef!\u201D"
    characterEmotion: 0
    continueCheck: 0
  - character: {fileID: 11400000, guid: 66353d41dda40ed4b916194c7b110f3c, type: 2}
    charText: "\u201CGood evening. I heard a famous food critic has come to visit
      us today.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: dcbb5bf5c792b71498b2fb1c38ad7fd7, type: 2}
    charText: "\u201CFamous might be a bit too much. But yes, I\u2019m here for your
      Ph\u1EDF.\u201D"
    characterEmotion: 0
    continueCheck: 1
  - character: {fileID: 11400000, guid: 66353d41dda40ed4b916194c7b110f3c, type: 2}
    charText: "\u201CThen I shall personally prepare it for you.\u201D"
    characterEmotion: 0
    continueCheck: 0
